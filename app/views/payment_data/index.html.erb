<h1>取込データ一覧</h1>

<table>
  <thead>
    <tr>
      <th>履歴NO</th>
      <th>行NO</th>
      <th>会社</th>
      <th>部門</th>
      <th>金額</th>
      <th>摘要</th>
    </tr>
  </thead>
  <tbody>
    <% @payment_data.each do |row| %>
      <tr>
        <td><%= row.capture_history_no %></td>
        <td><%= row.row_no %></td>
        <td><%= row.company&.company_name %></td>
        <td><%= row.department&.department_name %></td>
        <td><%= number_to_currency(row.amount, unit: "¥", precision: 0) %></td>
        <td><%= row.summary %></td>
      </tr>
    <% end %>
  </tbody>
</table>
