<h1>取込データ一覧</h1>

<%= list_count(@payment_data) %>

<table>
  <thead>
    <tr>
      <th>取込データNO</th>
      <th>取込区分</th>
      <th>履歴NO</th>
      <th>行NO</th>
      <th>会社コード</th>
      <th>会社名</th>
      <th>部門NO</th>
      <th>部門名</th>
      <th>仕入先ID</th>
      <th>勘定科目コード</th>
      <th>補助科目コード</th>
      <th>リストCD</th>
      <th>金額</th>
      <th>第二金額</th>
      <th>税区分</th>
      <th>税率</th>
      <th>摘要</th>
    </tr>
  </thead>
  <tbody>
    <% @payment_data.each do |row| %>
      <tr>
        <td><%= row.id %></td>
        <td><%= row.capture_history&.capture_category&.name %></td>
        <td><%= row.capture_history_id %></td>
        <td><%= row.row_no %></td>
        <td><%= row.company_code %></td>
        <td><%= row.company&.name %></td>
        <td><%= row.department_code %></td>
        <td><%= row.department&.name %></td>
        <td><%= row.business_connection_code %></td>
        <td><%= row.account_code %></td>
        <td><%= row.account_sub_code %></td>
        <td><%= row.list_cd %></td>
        <td><%= number_to_currency(row.amount, unit: "¥", precision: 0) %></td>
        <td><%= number_to_currency(row.second_amount, unit: "¥", precision: 0) %></td>
        <td><%= display_reference(row.tax_class_id, row.tax_class&.name) %></td>
        <td><%= display_reference(row.tax_rate_id, row.tax_rate&.rate) %></td>
        <td><%= row.summary %></td>
      </tr>
    <% end %>
  </tbody>
</table>
