<h1>会社マスタ</h1>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>会社コード</th>
      <th>会社名</th>
      <th>取引先コード</th>
      <th>取引先</th>
    </tr>
  </thead>
  <tbody>
    <% @companies.each do |company| %>
      <tr>
        <td><%= company.id %></td>
        <td><%= company.code %></td>
        <td><%= company.name %></td>
        <td><%= company.business_connection_code %></td>
        <td><%= company.business_connection&.name %></td>
      </tr>
    <% end %>
  </tbody>
</table>
