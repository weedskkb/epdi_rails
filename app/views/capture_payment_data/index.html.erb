<h1>支払データ取込</h1>

<%= form_with model: @view_model, url: capture_capture_payment_data_path, local: true, method: :post, html: { multipart: true } do |form| %>
  <section class="capturecategory-radio">
    <% selected = params.dig(:capture_payment_data_view_model, :select_category).to_s %>
    <ul style="list-style: none; text-align:left;">
      <li>
        <%= form.radio_button :select_category, 1, class: 'select_category uniquedata', id: 'storedata', checked: selected == '1' %>
        <%= form.label :select_category, ' 店舗データ: 16 経費(店舗)ﾏﾈｰｼﾞｬｰ振込', for: 'storedata' %>
      </li>
      <li>
        <%= form.radio_button :select_category, 2, class: 'select_category uniquedata', id: 'fixeddata', checked: selected == '2' %>
        <%= form.label :select_category, ' 固定費データ: 24 経費(家賃)固定費', for: 'fixeddata' %>
      </li>
      <li>
        <%= form.radio_button :select_category, 3, class: 'select_category wholedata', id: 'wholedata', checked: selected == '3' %>
        <%= form.label :select_category, ' 卸データ: 1 医薬品(卸)', for: 'wholedata' %>
      </li>
      <li>
        <%= form.radio_button :select_category, 4, class: 'select_category sharedata', id: 'sharedata', checked: selected == '4' %>
        <%= form.label :select_category, ' 共有データ', for: 'sharedata' %>
      </li>
    </ul>
    <input type="hidden" />
  </section>

  <div>
    <%= form.label :accrual_month, "発生月" %>
    <%= form.text_field :accrual_month, placeholder: "YYYY-MM" %>
    <% if form.object.errors[:accrual_month].present? %>
      <div class="error"><%= form.object.errors[:accrual_month].join(', ') %></div>
    <% end %>
  </div>

  <div>
    <%= form.label :payment_month, "支払月" %>
    <%= form.text_field :payment_month, placeholder: "YYYY-MM" %>
    <% if form.object.errors[:payment_month].present? %>
      <div class="error"><%= form.object.errors[:payment_month].join(', ') %></div>
    <% end %>
  </div>

  <div>
    <%= form.label :capture_category_id, "取込データ" %>
    <%= form.select :capture_category_id, form.object.capture_category_options, include_blank: "選択してください" %>
    <% if form.object.errors[:capture_category_id].present? %>
      <div class="error"><%= form.object.errors[:capture_category_id].join(', ') %></div>
    <% end %>
  </div>

  <div>
    <%= form.label :file, "対象ファイル / フォルダ" %>
    <div class="file-input-group">
      <%= form.file_field :file, multiple: true, data: { behavior: "capture-file-input" } %>
      <div class="file-input-toggles">
        <label>
          <input type="radio" name="capture-file-input-mode" value="file" checked>
          ファイル選択
        </label>
        <label>
          <input type="radio" name="capture-file-input-mode" value="folder">
          フォルダ選択
        </label>
      </div>
    </div>
    <% if form.object.errors[:file].present? %>
      <div class="error"><%= form.object.errors[:file].join(', ') %></div>
    <% end %>
  </div>

  <div>
    <label>
      <%= form.check_box :overwrite %>
      上書き取込
    </label>
  </div>

  <div>
    <%= form.submit "取込" %>
  </div>
<% end %>

<script>
  (function() {
    var initialized = false;

    function setup() {
      if (initialized) return;
      var input = document.querySelector('[data-behavior="capture-file-input"]');
      if (!input) return;
      var modes = document.getElementsByName('capture-file-input-mode');
      if (!modes.length) return;

      function updateAttributes(mode) {
        if (mode === 'folder') {
          input.setAttribute('webkitdirectory', '');
          input.setAttribute('directory', '');
        } else {
          input.removeAttribute('webkitdirectory');
          input.removeAttribute('directory');
        }
        input.value = '';
      }

      Array.prototype.forEach.call(modes, function(modeInput) {
        modeInput.addEventListener('change', function(event) {
          if (event.target.checked) {
            updateAttributes(event.target.value);
          }
        });
      });

      updateAttributes('file');
      initialized = true;
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setup);
    } else {
      setup();
    }

    document.addEventListener('turbo:load', setup);
  })();
</script>
