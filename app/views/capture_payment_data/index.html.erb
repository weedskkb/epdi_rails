<h1>支払データ取込</h1>

<%= form_with model: @view_model, url: capture_capture_payment_data_path, local: true, method: :post, html: { multipart: true } do |form| %>
  <section class="capturecategory-radio">
    <ul style="list-style: none; text-align:left;">
      <li><input type="radio" name="SelectCategory" class="uniquedata" id="storedata" value="1" /><label for="storedata"> 店舗データ</label></li>
      <li><input type="radio" name="SelectCategory" class="uniquedata" id="fixeddata" value="1" /><label for="fixeddata"> 固定費データ</label></li>
      <li><input type="radio" name="SelectCategory" class="wholedata" id="wholedata" value="2" /><label for="wholedata"> 卸データ</label></li>
      <li><input type="radio" name="SelectCategory" class="sharedata" id="sharedata" value="2" /><label for="sharedata"> 共有データ</label></li>
    </ul>
    <input type="hidden" />
  </section>

  <div>
    <%= form.label :target_month, "対象月" %>
    <%= form.text_field :target_month, placeholder: "YYYY-MM" %>
    <% if form.object.errors[:target_month].present? %>
      <div class="error"><%= form.object.errors[:target_month].join(', ') %></div>
    <% end %>
  </div>

  <div>
    <%= form.label :accrual_month, "発生月" %>
    <%= form.text_field :accrual_month, placeholder: "YYYY-MM" %>
    <% if form.object.errors[:accrual_month].present? %>
      <div class="error"><%= form.object.errors[:accrual_month].join(', ') %></div>
    <% end %>
  </div>

  <div>
    <%= form.label :payment_month, "支払月" %>
    <%= form.text_field :payment_month, placeholder: "YYYY-MM" %>
    <% if form.object.errors[:payment_month].present? %>
      <div class="error"><%= form.object.errors[:payment_month].join(', ') %></div>
    <% end %>
  </div>

  <div>
    <%= form.label :capture_category_id, "取込データ" %>
    <%= form.select :capture_category_id, form.object.capture_category_options, include_blank: "選択してください" %>
    <% if form.object.errors[:capture_category_id].present? %>
      <div class="error"><%= form.object.errors[:capture_category_id].join(', ') %></div>
    <% end %>
  </div>

  <div>
    <%= form.label :file, "対象ファイル" %>
    <%= form.file_field :file, multiple: false %>
    <% if form.object.errors[:file].present? %>
      <div class="error"><%= form.object.errors[:file].join(', ') %></div>
    <% end %>
  </div>

  <div>
    <label>
      <%= form.check_box :overwrite %>
      上書き取込
    </label>
  </div>

  <div>
    <%= form.submit "取込" %>
  </div>
<% end %>
