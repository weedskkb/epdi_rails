<h1>仕訳パターンマスタ</h1>

<style>
  .journal-entry-patterns-table {
    overflow: auto;
    max-height: calc(100vh - 220px);
    padding: 8px;
    background: #ffffff;
    border-radius: 6px;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08);
  }

  .journal-entry-patterns-table table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
    white-space: nowrap;
    table-layout: fixed;
  }

  .journal-entry-patterns-table th {
    background: #f0f4f9;
    font-weight: 600;
    position: sticky;
    top: 0;
    z-index: 1;
  }

  .journal-entry-patterns-table th,
  .journal-entry-patterns-table td {
    padding: 6px 8px;
    border-bottom: 1px solid #e4e9f2;
    text-align: left;
  }

  .journal-entry-patterns-table th.wrap,
  .journal-entry-patterns-table td.wrap {
    white-space: normal;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .journal-entry-patterns-table .column-key {
    display: block;
    margin-top: 2px;
    font-size: 10px;
    color: #64748b;
    letter-spacing: 0.02em;
    overflow-wrap: anywhere;
    word-break: break-all;
  }

  .journal-entry-patterns-table td.actions {
    text-align: center;
    white-space: nowrap;
  }

  .journal-entry-patterns-table .action-link {
    display: inline-block;
    padding: 4px 8px;
    border-radius: 4px;
    background: #2563eb;
    color: #fff;
    font-size: 11px;
    text-decoration: none;
  }

  .journal-entry-patterns-table tbody tr.group-highlight {
    background: var(--group-color, #fff);
    transition: background 0.2s ease;
  }

  .journal-entry-patterns-table tbody tr.group-highlight:hover {
    background: var(--group-color-hover, var(--group-color, #fff));
  }
</style>

<%= list_count(@patterns) %>

<div class="journal-entry-patterns-table">
  <table>
    <thead>
      <tr>
        <th class="wrap">パターンNO<span class="column-key">id</span></th>
        <th class="wrap">グループNO<span class="column-key">group_no</span></th>
        <th class="wrap">パターン名<span class="column-key">name</span></th>
        <th class="wrap">行NO<span class="column-key">row_no</span></th>
        <th class="wrap">日付パターンNO<span class="column-key">date_pattern_no</span></th>
        <th class="wrap">会社<span class="column-key">company_code</span></th>
        <th class="wrap">借方部署<span class="column-key">debit_department_code</span></th>
        <th class="wrap">借方勘定科目<span class="column-key">debit_account_code</span></th>
        <th class="wrap">借方補助科目<span class="column-key">debit_account_sub_code</span></th>
        <th class="wrap">借方取引先<span class="column-key">debit_business_connection_code</span></th>
        <th class="wrap">借方税率<span class="column-key">debit_tax_rate_code</span></th>
        <th class="wrap">借方税区分<span class="column-key">debit_tax_class_code</span></th>
        <th class="wrap">貸方部署<span class="column-key">credit_department_code</span></th>
        <th class="wrap">貸方勘定科目<span class="column-key">credit_account_code</span></th>
        <th class="wrap">貸方補助科目<span class="column-key">credit_account_sub_code</span></th>
        <th class="wrap">貸方取引先<span class="column-key">credit_business_connection_code</span></th>
        <th class="wrap">貸方税率<span class="column-key">credit_tax_rate_code</span></th>
        <th class="wrap">貸方税区分<span class="column-key">credit_tax_class_code</span></th>
        <th class="wrap">固定金額フラグ<span class="column-key">fixed_amount_flag</span></th>
        <th class="wrap">固定金額<span class="column-key">fixed_amount</span></th>
        <th class="wrap">按分率フラグ<span class="column-key">filter_ratio_flag</span></th>
        <th class="wrap">按分率<span class="column-key">filter_ratio</span></th>
        <th class="wrap">按分金額フラグ<span class="column-key">filter_amount_flag</span></th>
        <th class="wrap">按分金額<span class="column-key">filter_amount</span></th>
        <th class="wrap">明細区分<span class="column-key">detail_division_no</span></th>
        <th class="wrap">税込フラグ<span class="column-key">include_tax_flag</span></th>
        <th class="wrap">税計算フラグ<span class="column-key">tax_calc_flag</span></th>
        <th class="wrap">発生計上フラグ<span class="column-key">accure_flag</span></th>
        <th class="wrap">削除フラグ<span class="column-key">delete_flg</span></th>
        <th class="wrap">摘要<span class="column-key">abstract</span></th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% color_palette = ["#e8f4ff", "#fef3c7", "#e0f2f1", "#f3e8ff", "#ffe4e6", "#ede9fe", "#f0f9ff", "#fdf2f8"] %>
      <% lighten_color = lambda do |hex, ratio = 0.85|
          hex = hex.delete("#")
          hex = hex.chars.flat_map { |c| [c, c] }.join if hex.length == 3
          rgb = [
            hex[0..1].to_i(16),
            hex[2..3].to_i(16),
            hex[4..5].to_i(16)
          ]
          blended = rgb.map do |channel|
            [(channel * ratio + 255 * (1 - ratio)).round, 255].min
          end
          format("#%02x%02x%02x", *blended)
        end %>
      <% group_colors = {} %>
      <% @patterns.each do |pattern| %>
        <% base_color = group_colors[pattern.group_no] ||= color_palette[group_colors.size % color_palette.size] %>
        <% hover_color = lighten_color.call(base_color, 0.7) %>
        <tr class="group-highlight" style="--group-color: <%= base_color %>; --group-color-hover: <%= hover_color %>;">
          <td class="wrap"><%= pattern.id %></td>
          <td class="wrap"><%= pattern.group_no %></td>
          <td class="wrap"><%= pattern.name %></td>
          <td class="wrap"><%= pattern.row_no %></td>
          <td class="wrap"><%= pattern.date_pattern_no %></td>
          <td class="wrap"><%= display_reference(pattern.company_code, pattern.company&.name) %></td>
          <td class="wrap"><%= display_reference(pattern.debit_department_code, pattern.debit_department&.name) %></td>
          <td class="wrap"><%= pattern.debit_account_code %></td>
          <td class="wrap"><%= pattern.debit_account_sub_code || "-" %></td>
          <td class="wrap"><%= display_reference(pattern.debit_business_connection_code, pattern.debit_business_connection&.name) %></td>
          <td class="wrap"><%= enum_label(pattern, :debit_tax_rate_code) %></td>
          <td class="wrap"><%= enum_label(pattern, :debit_tax_class_code) %></td>
          <td class="wrap"><%= display_reference(pattern.credit_department_code, pattern.credit_department&.name) %></td>
          <td class="wrap"><%= pattern.credit_account_code %></td>
          <td class="wrap"><%= pattern.credit_account_sub_code || "-" %></td>
          <td class="wrap"><%= display_reference(pattern.credit_business_connection_code, pattern.credit_business_connection&.name) %></td>
          <td class="wrap"><%= enum_label(pattern, :credit_tax_rate_code) %></td>
          <td class="wrap"><%= enum_label(pattern, :credit_tax_class_code) %></td>
          <td class="wrap"><%= pattern.fixed_amount_flag ? "有" : "無" %></td>
          <td class="wrap"><%= pattern.fixed_amount %></td>
          <td class="wrap"><%= pattern.filter_ratio_flag ? "有" : "無" %></td>
          <td class="wrap"><%= pattern.filter_ratio %></td>
          <td class="wrap"><%= pattern.filter_amount_flag ? "有" : "無" %></td>
          <td class="wrap"><%= pattern.filter_amount %></td>
          <td class="wrap"><%= pattern.detail_division_no %></td>
          <td class="wrap"><%= pattern.include_tax_flag ? "有" : "無" %></td>
          <td class="wrap"><%= pattern.tax_calc_flag ? "有" : "無" %></td>
          <td class="wrap"><%= pattern.accure_flag ? "有" : "無" %></td>
          <td class="wrap"><%= pattern.delete_flg ? "有" : "無" %></td>
          <td class="wrap"><%= pattern.abstract %></td>
          <td class="actions"><%= link_to "編集", edit_journal_entry_pattern_path(pattern), class: "action-link" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
