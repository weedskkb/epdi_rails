<h1>仕訳パターンマスタ</h1>

<style>
  .journal-entry-patterns-table {
    overflow: auto;
    max-height: calc(100vh - 220px);
    padding: 8px;
    background: #ffffff;
    border-radius: 6px;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08);
  }

  .journal-entry-patterns-table table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
    white-space: nowrap;
    table-layout: fixed;
  }

  .journal-entry-patterns-table th {
    background: #f0f4f9;
    font-weight: 600;
    position: sticky;
    top: 0;
    z-index: 1;
  }

  .journal-entry-patterns-table th,
  .journal-entry-patterns-table td {
    padding: 6px 8px;
    border-bottom: 1px solid #e4e9f2;
    text-align: left;
  }

  .journal-entry-patterns-table tbody tr:nth-child(even) {
    background: #f9fbff;
  }

  .journal-entry-patterns-table th.wrap,
  .journal-entry-patterns-table td.wrap {
    white-space: normal;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .journal-entry-patterns-table .column-key {
    display: block;
    margin-top: 2px;
    font-size: 10px;
    color: #64748b;
    letter-spacing: 0.02em;
    overflow-wrap: anywhere;
    word-break: break-all;
  }

  .journal-entry-patterns-table td.actions {
    text-align: center;
    white-space: nowrap;
  }

  .journal-entry-patterns-table .action-link {
    display: inline-block;
    padding: 4px 8px;
    border-radius: 4px;
    background: #2563eb;
    color: #fff;
    font-size: 11px;
    text-decoration: none;
  }
</style>

<div class="journal-entry-patterns-table">
  <table>
    <thead>
      <tr>
        <th class="wrap">パターンNO<span class="column-key">JOURNAL_ENTRY_PATTERN_NO</span></th>
        <th class="wrap">グループNO<span class="column-key">JOURNAL_ENTRY_PATTERN_GROUP_NO</span></th>
        <th class="wrap">パターン名<span class="column-key">JOURNAL_ENTRY_PATTERN_NAME</span></th>
        <th class="wrap">行NO<span class="column-key">ROW_NO</span></th>
        <th class="wrap">日付パターンNO<span class="column-key">DATE_PATTERN_NO</span></th>
        <th class="wrap">会社<span class="column-key">COMPANY_ID</span></th>
        <th class="wrap">借方部署<span class="column-key">DEBIT_DEPARTMENT_ID</span></th>
        <th class="wrap">借方勘定科目<span class="column-key">debit_account_code</span></th>
        <th class="wrap">借方補助科目<span class="column-key">debit_account_sub_code</span></th>
        <th class="wrap">借方取引先<span class="column-key">DEBIT_SUPPLIER_ID</span></th>
        <th class="wrap">借方税率<span class="column-key">DEBIT_TAX_RATE_ID</span></th>
        <th class="wrap">借方税区分<span class="column-key">DEBIT_TAX_CLASS_ID</span></th>
        <th class="wrap">貸方部署<span class="column-key">CREDIT_DEPARTMENT_ID</span></th>
        <th class="wrap">貸方勘定科目<span class="column-key">credit_account_code</span></th>
        <th class="wrap">貸方補助科目<span class="column-key">credit_account_sub_code</span></th>
        <th class="wrap">貸方取引先<span class="column-key">CREDIT_SUPPLIER_ID</span></th>
        <th class="wrap">貸方税率<span class="column-key">CREDIT_TAX_RATE_ID</span></th>
        <th class="wrap">貸方税区分<span class="column-key">CREDIT_TAX_CLASS_ID</span></th>
        <th class="wrap">固定金額フラグ<span class="column-key">FIXED_AMOUNT_FLG</span></th>
        <th class="wrap">固定金額<span class="column-key">FIXED_AMOUNT</span></th>
        <th class="wrap">按分率フラグ<span class="column-key">FILTER_RATIO_FLG</span></th>
        <th class="wrap">按分率<span class="column-key">FILTER_RATIO</span></th>
        <th class="wrap">按分金額フラグ<span class="column-key">FILTER_AMOUNT_FLG</span></th>
        <th class="wrap">按分金額<span class="column-key">FILTER_AMOUNT</span></th>
        <th class="wrap">明細区分<span class="column-key">DETAIL_DIVISION_NO</span></th>
        <th class="wrap">税込フラグ<span class="column-key">INCLUDE_TAX_FLG</span></th>
        <th class="wrap">税計算フラグ<span class="column-key">TAX_CALC_FLG</span></th>
        <th class="wrap">発生計上フラグ<span class="column-key">ACCURE_FLG</span></th>
        <th class="wrap">削除フラグ<span class="column-key">DELETE_FLG</span></th>
        <th class="wrap">摘要<span class="column-key">ABSTRACT</span></th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% @patterns.each do |pattern| %>
        <tr>
          <td class="wrap"><%= pattern.journal_entry_pattern_no %></td>
          <td class="wrap"><%= pattern.journal_entry_pattern_group_no %></td>
          <td class="wrap"><%= pattern.journal_entry_pattern_name %></td>
          <td class="wrap"><%= pattern.row_no %></td>
          <td class="wrap"><%= pattern.date_pattern_no %></td>
          <td class="wrap"><%= display_reference(pattern.company_id, pattern.company&.name) %></td>
          <td class="wrap"><%= display_reference(pattern.debit_department_id, pattern.debit_department&.department_name) %></td>
          <td class="wrap"><%= pattern.debit_account_code %></td>
          <td class="wrap"><%= pattern.debit_account_sub_code || "-" %></td>
          <td class="wrap"><%= display_reference(pattern.debit_tax_rate_id, pattern.debit_tax_rate&.rate) %></td>
          <td class="wrap"><%= display_reference(pattern.debit_tax_class_id, pattern.debit_tax_class&.name) %></td>
          <td class="wrap"><%= display_reference(pattern.credit_department_id, pattern.credit_department&.department_name) %></td>
          <td class="wrap"><%= pattern.credit_account_code %></td>
          <td class="wrap"><%= pattern.credit_account_sub_code || "-" %></td>
          <td class="wrap"><%= display_reference(pattern.debit_supplier_id, pattern.debit_supplier&.name) %></td>
          <td class="wrap"><%= display_reference(pattern.credit_tax_rate_id, pattern.credit_tax_rate&.rate) %></td>
          <td class="wrap"><%= display_reference(pattern.credit_tax_class_id, pattern.credit_tax_class&.name) %></td>
          <td class="wrap"><%= pattern.fixed_amount_flag ? "有" : "無" %></td>
          <td class="wrap"><%= pattern.fixed_amount %></td>
          <td class="wrap"><%= pattern.filter_ratio_flag ? "有" : "無" %></td>
          <td class="wrap"><%= pattern.filter_ratio %></td>
          <td class="wrap"><%= pattern.filter_amount_flag ? "有" : "無" %></td>
          <td class="wrap"><%= pattern.filter_amount %></td>
          <td class="wrap"><%= pattern.detail_division_no %></td>
          <td class="wrap"><%= pattern.include_tax_flag ? "有" : "無" %></td>
          <td class="wrap"><%= pattern.tax_calc_flag ? "有" : "無" %></td>
          <td class="wrap"><%= pattern.accure_flag ? "有" : "無" %></td>
          <td class="wrap"><%= pattern.delete_flg ? "有" : "無" %></td>
          <td class="wrap"><%= pattern.abstract %></td>
          <td class="actions"><%= link_to "編集", edit_journal_entry_pattern_path(pattern), class: "action-link" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
