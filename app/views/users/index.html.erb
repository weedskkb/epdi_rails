<h1>ユーザー一覧</h1>

<%= link_to "新規登録", new_user_path %>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>ログインID</th>
      <th>権限</th>
      <th>状態</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.user_id %></td>
        <td><%= user.login_id %></td>
        <td><%= user.authority&.autholity_name %></td>
        <td><%= user.status&.status_name %></td>
        <td>
          <%= link_to "詳細", user_path(user) %>
          <%= link_to "編集", edit_user_path(user) %>
          <%= button_to "削除", user_path(user), method: :delete, data: { confirm: "削除しますか?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
