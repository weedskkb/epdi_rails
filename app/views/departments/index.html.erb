<h1>部門マスタ</h1>

<style>
  .hidden-department {
    color: #666;
    background-color: #f2f2f2;
  }
</style>

<table>
  <thead>
    <tr>
      <th>部門ID</th>
      <th>部門コード</th>
      <th>部門名</th>
      <th>店舗コード</th>
      <th>店舗名</th>
      <th>会社コード</th>
      <th>会社名</th>
      <th>非表示</th>
    </tr>
  </thead>
  <tbody>
    <% @departments.each do |department| %>
      <% company = department.get_company(Date.today) %>
      <tr class="<%= 'hidden-department' if department.hidden? %>">
        <td><%= department.id %></td>
        <td><%= department.code %></td>
        <td><%= department.name %></td>
        <td><%= department.store_code %></td>
        <td><%= department.store_name %></td>
        <td><%= company&.code %></td>
        <td><%= company&.name %></td>
        <td><%= department.hidden? %></td>
      </tr>
    <% end %>
  </tbody>
</table>
