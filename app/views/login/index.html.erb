<h1>ログイン</h1>

<%= form_with model: @form, url: login_path, method: :post, local: true do |form| %>
  <div>
    <%= form.label :login_id, "ログインID" %>
    <%= form.text_field :login_id %>
    <% if form.object.errors[:login_id].present? %>
      <div class="error"><%= form.object.errors[:login_id].join(', ') %></div>
    <% end %>
  </div>
  <div>
    <%= form.label :password, "パスワード" %>
    <%= form.password_field :password %>
    <% if form.object.errors[:password].present? %>
      <div class="error"><%= form.object.errors[:password].join(', ') %></div>
    <% end %>
  </div>
  <div>
    <%= form.submit "ログイン" %>
  </div>
<% end %>
