<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="utf-8">
    <title>EPDI</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <style>
      *, *::before, *::after {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: #f8f9fb;
        color: #222;
      }

      a {
        color: inherit;
      }

      .app-shell {
        display: flex;
        min-height: 100vh;
      }

      .sidebar {
        width: 220px;
        background: #1f2933;
        color: #f5f7fa;
        padding: 20px 16px;
      }

      .sidebar-title {
        font-size: 16px;
        font-weight: bold;
        margin-bottom: 12px;
      }

      .nav-menu {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .nav-menu li {
        margin-bottom: 6px;
      }

      .nav-menu .menu-divider {
        margin: 12px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.2);
        padding: 0;
        height: 0;
      }

      .table-meta {
        margin: 8px 0 12px;
        font-size: 12px;
        color: #94a3b8;
      }

      .nav-menu a {
        display: block;
        padding: 8px 10px;
        text-decoration: none;
        border-radius: 4px;
        color: inherit;
      }

      .nav-menu a:hover {
        background: rgba(255, 255, 255, 0.15);
      }

      .nav-menu a.active {
        background: #3d4a58;
        font-weight: bold;
      }

      .app-main {
        flex: 1;
        display: flex;
        flex-direction: column;
      }

      .topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 24px;
        background: #ffffff;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.05);
      }

      .topbar form {
        margin: 0;
      }

      .flash-container {
        padding: 16px 24px 0;
      }

      .flash {
        margin-bottom: 12px;
        padding: 10px 12px;
        border-radius: 4px;
        background: #edf2ff;
        color: #1b2a4e;
      }

      main.app-content {
        flex: 1;
        padding: 24px;
      }

      .guest-container {
        max-width: 480px;
        margin: 80px auto;
        padding: 24px;
        background: #ffffff;
        border-radius: 8px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
      }
    </style>
  </head>
  <body>
    <% if signed_in? %>
      <div class="app-shell">
        <aside class="sidebar">
          <div class="sidebar-title">メニュー</div>
          <ul class="nav-menu">
            <% main_menu_links.each do |item| %>
              <% label = item[:label] %>
              <% path = item[:path] %>
              <li><%= link_to label, path, class: ("active" if current_page?(path)) %></li>
              <% if item[:divider_after] %>
                <li class="menu-divider"></li>
              <% end %>
            <% end %>
          </ul>
        </aside>
        <div class="app-main">
          <header class="topbar">
            <div>ログイン中: <%= current_user.login_id %></div>
            <%= button_to "ログアウト", logout_path, method: :delete %>
          </header>
          <div class="flash-container">
            <% flash.each do |type, message| %>
              <div class="flash <%= type %>"><%= message %></div>
            <% end %>
          </div>
          <main class="app-content">
            <%= yield %>
          </main>
        </div>
      </div>
    <% else %>
      <div class="guest-container">
        <% flash.each do |type, message| %>
          <div class="flash <%= type %>"><%= message %></div>
        <% end %>
        <%= yield %>
      </div>
    <% end %>
  </body>
</html>
