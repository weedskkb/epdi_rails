<h1>BS取引先マスタ</h1>

<%= list_count(@suppliers) %>

<table>
  <thead>
    <tr>
      <th>取引先ID</th>
      <th>取引先名</th>
    </tr>
  </thead>
  <tbody>
    <% @suppliers.each do |supplier| %>
      <tr>
        <td><%= supplier.id %></td>
        <td><%= supplier.name %></td>
      </tr>
    <% end %>
  </tbody>
</table>
