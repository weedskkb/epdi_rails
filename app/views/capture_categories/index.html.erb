<h1>取込区分マスタ</h1>

<style>
  .capture-categories-table {
    overflow: auto;
    max-height: calc(100vh - 220px);
    padding: 8px;
    background: #ffffff;
    border-radius: 6px;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08);
  }

  .capture-categories-table table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
    white-space: nowrap;
    table-layout: fixed;
  }

  .capture-categories-table th {
    background: #f0f4f9;
    font-weight: 600;
    position: sticky;
    top: 0;
    z-index: 1;
  }

  .capture-categories-table th,
  .capture-categories-table td {
    padding: 6px 8px;
    border-bottom: 1px solid #e4e9f2;
    text-align: left;
  }

  .capture-categories-table tbody tr:nth-child(even) {
    background: #f9fbff;
  }

  .capture-categories-table th.wrap,
  .capture-categories-table td.wrap {
    white-space: normal;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .capture-categories-table .column-key {
    display: block;
    margin-top: 2px;
    font-size: 10px;
    color: #64748b;
    letter-spacing: 0.02em;
    overflow-wrap: anywhere;
    word-break: break-all;
  }

  .capture-categories-table td.actions {
    text-align: center;
    white-space: nowrap;
  }

  .capture-categories-table .action-link {
    display: inline-block;
    padding: 4px 8px;
    border-radius: 4px;
    background: #2563eb;
    color: #fff;
    font-size: 11px;
    text-decoration: none;
  }
</style>

<div class="capture-categories-table">
  <table>
    <thead>
      <tr>
        <th class="wrap">取込区分ID<span class="column-key">id</span></th>
        <th class="wrap">取込区分名<span class="column-key">name</span></th>
        <th class="wrap">税区分<span class="column-key">TAX_CLASS_ID</span></th>
        <th class="wrap">税率<span class="column-key">TAX_RATE_ID</span></th>
        <th class="wrap">取引先<span class="column-key">business_connection_code</span></th>
        <th class="wrap">取引先会社<span class="column-key">business_connection_company_code</span></th>
        <th class="wrap">借方部署<span class="column-key">DEBIT_DEPARTMENT_ID</span></th>
        <th class="wrap">借方勘定科目<span class="column-key">debit_account_code</span></th>
        <th class="wrap">借方補助科目<span class="column-key">debit_account_sub_code</span></th>
        <th class="wrap">貸方部署<span class="column-key">CREDIT_DEPARTMENT_ID</span></th>
        <th class="wrap">貸方勘定科目<span class="column-key">credit_account_code</span></th>
        <th class="wrap">貸方補助科目<span class="column-key">credit_account_sub_code</span></th>
        <th class="wrap">摘要<span class="column-key">ABSTRACT</span></th>
        <th class="wrap">仕入先別摘要<span class="column-key">SUPPLIER_ABSTRACT</span></th>
        <th class="wrap">仕訳パターングループ<span class="column-key">journal_entry_pattern_group_no</span></th>
        <th class="wrap">支払条件<span class="column-key">PAYMENT_TERMS</span></th>
        <th class="wrap">削除フラグ<span class="column-key">DELETE_FLG</span></th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% @capture_categories.each do |category| %>
        <tr>
          <td class="wrap"><%= category.id %></td>
          <td class="wrap"><%= category.name %></td>
          <td class="wrap"><%= display_reference(category.tax_class_id, category.tax_class&.name) %></td>
          <td class="wrap"><%= display_reference(category.tax_rate_id, category.tax_rate&.rate) %></td>
          <td class="wrap"><%= display_reference(category.business_connection_code, category.business_connection&.name) %></td>
          <td class="wrap"><%= display_reference(category.business_connection_company_code, category.business_connection_company&.name) %></td>
          <td class="wrap"><%= display_reference(category.debit_department_id, category.debit_department&.department_name) %></td>
          <td class="wrap"><%= category.debit_account_code %></td>
          <td class="wrap"><%= category.debit_account_sub_code || "-" %></td>
          <td class="wrap"><%= display_reference(category.credit_department_id, category.credit_department&.department_name) %></td>
          <td class="wrap"><%= category.credit_account_code %></td>
          <td class="wrap"><%= category.credit_account_sub_code || "-" %></td>
          <td class="wrap"><%= category.abstract %></td>
          <td class="wrap"><%= category.supplier_abstract %></td>
          <td class="wrap"><%= category.journal_entry_pattern_group_no %></td>
          <td class="wrap"><%= category.payment_terms %></td>
          <td class="wrap"><%= category.delete_flg ? "有" : "無" %></td>
          <td class="actions"><%= link_to "編集", edit_capture_category_path(category), class: "action-link" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
